root = true

# =====================================================================
# .editorconfig
# Mapped from: C# Test Automation Coding Standards document
# Scope: applies to all .cs files in the solution unless overridden
#        by a more specific .editorconfig in a subfolder.
# =====================================================================

[*.cs]

# ---------------------------------------------------------------------
# 1. FORMATTING RULES
# ---------------------------------------------------------------------

indent_style = space
indent_size = 4
tab_width = 4
end_of_line = crlf
charset = utf-8-bom
trim_trailing_whitespace = true
insert_final_newline = true

# Allman style braces: opening brace on its own new line
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true

# Using directives: sorted alphabetically, System.* first
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# Remove unused using directives
dotnet_diagnostic.IDE0005.severity = warning

# Always specify access modifiers explicitly
dotnet_style_require_accessibility_modifiers = always:warning

# Spacing
csharp_space_around_binary_operators = before_and_after
csharp_space_after_comma = true
csharp_space_before_comma = false
csharp_space_before_semicolon_in_for_statement = false
csharp_space_after_semicolon_in_for_statement = true
csharp_space_before_open_square_brackets = false

# Using directives must be placed outside namespace
csharp_using_directive_placement = outside_namespace:warning

# ---------------------------------------------------------------------
# 2. NAMING CONVENTIONS
# ---------------------------------------------------------------------

# Classes: PascalCase
dotnet_naming_rule.classes_should_be_pascal_case.symbols = class_symbol
dotnet_naming_rule.classes_should_be_pascal_case.style = pascal_case_style
dotnet_naming_rule.classes_should_be_pascal_case.severity = warning

dotnet_naming_symbols.class_symbol.applicable_kinds = class
dotnet_naming_symbols.class_symbol.applicable_accessibilities = *

# Interfaces: PascalCase with "I" prefix
dotnet_naming_rule.interfaces_should_be_prefixed.symbols = interface_symbol
dotnet_naming_rule.interfaces_should_be_prefixed.style = interface_style
dotnet_naming_rule.interfaces_should_be_prefixed.severity = warning

dotnet_naming_symbols.interface_symbol.applicable_kinds = interface
dotnet_naming_symbols.interface_symbol.applicable_accessibilities = *

dotnet_naming_style.interface_style.required_prefix = I
dotnet_naming_style.interface_style.capitalization = pascal_case

# Methods: PascalCase
dotnet_naming_rule.methods_should_be_pascal_case.symbols = method_symbol
dotnet_naming_rule.methods_should_be_pascal_case.style = pascal_case_style
dotnet_naming_rule.methods_should_be_pascal_case.severity = warning

dotnet_naming_symbols.method_symbol.applicable_kinds = method
dotnet_naming_symbols.method_symbol.applicable_accessibilities = *

# Private fields: camelCase with leading underscore
dotnet_naming_rule.private_fields_should_be_underscore_camel.symbols = private_field_symbol
dotnet_naming_rule.private_fields_should_be_underscore_camel.style = underscore_camel_case_style
dotnet_naming_rule.private_fields_should_be_underscore_camel.severity = warning

dotnet_naming_symbols.private_field_symbol.applicable_kinds = field
dotnet_naming_symbols.private_field_symbol.applicable_accessibilities = private
dotnet_naming_symbols.private_field_symbol.required_modifiers =

dotnet_naming_style.underscore_camel_case_style.required_prefix = _
dotnet_naming_style.underscore_camel_case_style.capitalization = camel_case

# Constants: PascalCase
dotnet_naming_rule.constants_should_be_pascal_case.symbols = constant_symbol
dotnet_naming_rule.constants_should_be_pascal_case.style = pascal_case_style
dotnet_naming_rule.constants_should_be_pascal_case.severity = warning

dotnet_naming_symbols.constant_symbol.applicable_kinds = field, local
dotnet_naming_symbols.constant_symbol.required_modifiers = const

# Local variables / parameters: camelCase
dotnet_naming_rule.locals_should_be_camel_case.symbols = local_symbol
dotnet_naming_rule.locals_should_be_camel_case.style = camel_case_style
dotnet_naming_rule.locals_should_be_camel_case.severity = suggestion

dotnet_naming_symbols.local_symbol.applicable_kinds = local, parameter

# Enums and enum members: PascalCase
dotnet_naming_rule.enums_should_be_pascal_case.symbols = enum_symbol
dotnet_naming_rule.enums_should_be_pascal_case.style = pascal_case_style
dotnet_naming_rule.enums_should_be_pascal_case.severity = warning

dotnet_naming_symbols.enum_symbol.applicable_kinds = enum

dotnet_naming_rule.enum_members_should_be_pascal_case.symbols = enum_member_symbol
dotnet_naming_rule.enum_members_should_be_pascal_case.style = pascal_case_style
dotnet_naming_rule.enum_members_should_be_pascal_case.severity = warning

dotnet_naming_symbols.enum_member_symbol.applicable_kinds = enum_member

# Shared naming styles
dotnet_naming_style.pascal_case_style.capitalization = pascal_case
dotnet_naming_style.camel_case_style.capitalization = camel_case

# ---------------------------------------------------------------------
# 3. STYLECOP RULE SEVERITIES
# These rules require the StyleCop.Analyzers NuGet package to be
# installed. Behavior details for some of these live in stylecop.json.
# ---------------------------------------------------------------------

# Elements must appear in the correct order
# (usings -> namespace -> constants -> fields -> constructors ->
#  properties -> public methods -> private methods)
dotnet_diagnostic.SA1201.severity = warning

# Elements must be ordered by access modifier (public before private)
dotnet_diagnostic.SA1202.severity = warning
csharp_preferred_modifier_order = public,private,protected,internal,file,const,static,extern,new,virtual,abstract,sealed,override,readonly,unsafe,required,volatile,async:suggestion

# Using directives must be sorted alphabetically
dotnet_diagnostic.SA1210.severity = warning

# Elements must be separated by a blank line
dotnet_diagnostic.SA1516.severity = warning

# Opening/closing braces on their own line (reinforces Allman style)
dotnet_diagnostic.SA1500.severity = warning

# XML documentation required on public elements.
dotnet_diagnostic.SA1600.severity = none
dotnet_diagnostic.SA0001.severity = none

# File header / copyright rule  usually not relevant for a test repo.
# Left disabled;
dotnet_diagnostic.SA1633.severity = none

#Other conflicting StyleCop rules that overpower .editorconfig
dotnet_diagnostic.SA1309.severity = none
dotnet_diagnostic.SA1101.severity = none
dotnet_diagnostic.SA1121.severity = none
dotnet_diagnostic.SA1009.severity = none
dotnet_diagnostic.SA1602.severity = none

# ---------------------------------------------------------------------
# 4. COMMONLY-ADOPTED DEFAULTS (not in the team's standards doc)
# ---------------------------------------------------------------------

# Use file-scoped namespace declaration 
csharp_style_namespace_declarations = file_scoped:warning

# var usage
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion
 
# Expression-bodied members ("=>" for simple one-line properties and accessors)
csharp_style_expression_bodied_methods = false:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_expression_bodied_accessors = true:suggestion
csharp_style_expression_bodied_indexers = true:suggestion
csharp_style_expression_bodied_lambdas = true:suggestion
 
# this. qualification (do not use unless ambiguous)
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion
dotnet_style_qualification_for_event = false:suggestion
 
# Null-checking and pattern-matching style
csharp_style_pattern_matching_over_is_with_cast_check = true:suggestion
csharp_style_pattern_matching_over_as_with_null_check = true:suggestion
csharp_style_prefer_null_check_over_type_check = true:suggestion

# Unused code and unreachable code detection
dotnet_diagnostic.IDE0059.severity = warning
dotnet_diagnostic.CS0164.severity = warning
dotnet_diagnostic.CS0162.severity = warning

# readonly field suggestions
dotnet_diagnostic.IDE0044.severity = warning

# Avoid catching overly general exception types
dotnet_diagnostic.CA1031.severity = suggestion

# Auto-properties
dotnet_style_prefer_auto_properties = true:suggestion

# Throw expressions
csharp_style_throw_expression = true:suggestion

# Prefer static method helpers for expressions
dotnet_diagnostic.CA1510.severity = suggestion
dotnet_diagnostic.CA1511.severity = suggestion
dotnet_diagnostic.CA1512.severity = suggestion
dotnet_diagnostic.CA1513.severity = suggestion

# Prefer concrete types instead of interfaces (supressed)
dotnet_diagnostic.CA1859.severity = none

  
[*.{json,xml,yml,yaml}]
indent_style = space
indent_size = 2
 
[*.csproj]
indent_style = space
indent_size = 2
 
[*.md]
trim_trailing_whitespace = false
